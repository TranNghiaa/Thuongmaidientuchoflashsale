<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Add InternalsVisibleTo for all modules and BuildingBlocks -->
  <ItemGroup Condition="($(MSBuildProjectName.StartsWith('ShopFlow.Modules.')) and !$(MSBuildProjectName.EndsWith('.Contracts'))) or ('$(MSBuildProjectName)' == 'ShopFlow.BuildingBlocks')">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ShopFlow.UnitTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ShopFlow.IntegrationTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Contracts')) and !$(MSBuildProjectName.EndsWith('Tests')) and $(MSBuildProjectName) != 'ShopFlow.Host'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
